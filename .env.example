# ---------------------------------------------------------------------------
# upay Shield — environment template
#
# Copy to `.env` and fill in real values. NEVER commit the filled-in `.env`.
# Every value below is a placeholder. See docs/deployment-render.md.
# ---------------------------------------------------------------------------

# --- Backend runtime -------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
# Listening port. Render provides this at runtime; do not hardcode in deploy.
PORT=8000

# --- Database --------------------------------------------------------------
# Managed PostgreSQL with TLS/pooling for deployed environments.
# Local development uses the Compose service defined in compose.yaml.
DATABASE_URL=postgresql+psycopg://shield:shield@localhost:5432/shield

# --- Authentication --------------------------------------------------------
# Supabase Auth is the default identity provider. The backend verifies signed
# tokens via issuer/audience/JWKS. Service-role keys stay server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Privileged server-side key. NEVER expose as a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=replace-me-server-side-only

# --- CORS ------------------------------------------------------------------
# Exact allowlist of frontend origins. CORS is not authentication.
CORS_ORIGINS=http://localhost:3000

# --- Model artifacts -------------------------------------------------------
# Directory holding the verified, checksummed model bundle.
MODEL_BUNDLE_PATH=ml/artifacts

# --- Public demo protection ------------------------------------------------
# When true, public seed demo data is immutable and mutation APIs are closed.
DEMO_READ_ONLY=true

# --- Optional LLM explanations (Gemini) ------------------------------------
# Leave blank to run the deterministic summary path only. The product must
# remain fully functional without this key.
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Frontend build-time configuration -------------------------------------
# Public frontend variables are inlined at build time; changing them needs a
# rebuild. These must never contain secrets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me-public-anon-key
